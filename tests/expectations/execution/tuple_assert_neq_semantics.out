    output r0 as tuple_assert_neq_semantics.aleo/assert_neq_all_different.future;

finalize assert_neq_all_different:
    assert.neq 1u32 3u32;
    assert.neq 2u32 4u32;

function assert_neq_equal:
    async assert_neq_equal into r0;
    output r0 as tuple_assert_neq_semantics.aleo/assert_neq_equal.future;

finalize assert_neq_equal:
    assert.neq 1u32 1u32;
    assert.neq 2u32 2u32;

constructor:
    assert.eq edition 0u16;
